<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DON DON Information Academy</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; }
        body { background-color: #0b132b; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; }
        
        .brand-header { text-align: center; margin-bottom: 25px; }
        .brand-name { font-size: 40px; font-weight: 900; letter-spacing: 3px; color: #38bdf8; text-transform: uppercase; text-shadow: 0 0 15px rgba(56, 189, 248, 0.5); margin-bottom: 6px; }
        .brand-sub { font-size: 13px; font-weight: 800; letter-spacing: 2px; color: #ffffff; text-transform: uppercase; background: #f43f5e; padding: 6px 18px; border-radius: 20px; display: inline-block; box-shadow: 0 4px 10px rgba(244, 63, 94, 0.4); }

        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.92); display: flex; align-items: center; justify-content: center; z-index: 1000; }
        .modal-box { background: #1c2541; padding: 30px 25px; border-radius: 16px; width: 90%; max-width: 380px; box-shadow: 0 15px 30px rgba(0,0,0,0.6); border: 1px solid #3a506b; text-align: center; }
        .modal-box h2 { color: #38bdf8; margin-bottom: 8px; font-size: 24px; }
        .modal-box p { font-size: 14px; color: #cbd5e1; margin-bottom: 20px; }
        
        input { width: 100%; padding: 12px 15px; margin-bottom: 15px; background: #0b132b; border: 1px solid #3a506b; border-radius: 8px; color: #fff; font-size: 15px; outline: none; }
        input:focus { border-color: #38bdf8; box-shadow: 0 0 8px rgba(56, 189, 248, 0.4); }
        
        .btn-main { width: 100%; padding: 13px; background: #0284c7; border: none; border-radius: 8px; color: #fff; font-weight: bold; font-size: 16px; cursor: pointer; transition: 0.3s; }
        .btn-main:hover { background: #0369a1; }

        .app-container { width: 100%; max-width: 550px; text-align: center; display: none; }
        .user-welcome { font-size: 14px; color: #38bdf8; margin-bottom: 20px; font-weight: 600; text-align: right; background: #1c2541; padding: 8px 15px; border-radius: 8px; border: 1px solid #3a506b; }
        
        .search-box { display: flex; gap: 10px; margin-bottom: 25px; }
        .search-box input { margin-bottom: 0; }
        .search-box button { width: auto; padding: 0 22px; white-space: nowrap; }

        .country-card { background: #1c2541; border-radius: 16px; padding: 25px; border: 1px solid #3a506b; display: none; text-align: left; box-shadow: 0 10px 25px rgba(0,0,0,0.4); }
        .flag-container { text-align: center; margin-bottom: 20px; }
        .flag-img { width: 130px; border-radius: 8px; box-shadow: 0 5px 15px rgba(0,0,0,0.5); border: 1px solid #3a506b; }
        .country-title { font-size: 26px; color: #38bdf8; margin-bottom: 15px; border-bottom: 2px solid #3a506b; padding-bottom: 10px; text-align: center; }
        .info-row { font-size: 16px; margin-bottom: 10px; color: #cbd5e1; line-height: 1.5; }
        .info-row strong { color: #ffffff; }
        .error-msg { color: #f43f5e; margin-top: 15px; display: none; font-weight: bold; font-size: 15px; background: rgba(244, 63, 94, 0.1); padding: 10px; border-radius: 8px; border: 1px solid #f43f5e; }
    </style>
</head>
<body>

    <!-- Identity Verification Modal -->
    <div class="modal-overlay" id="identityModal">
        <div class="modal-box">
            <h2>User Access</h2>
            <p>Website use karne ke liye apna Name aur Age darj karein.</p>
            <input type="text" id="userName" placeholder="Apna Poora Naam Likhain">
            <input type="number" id="userAge" placeholder="Apni Umhar (Age) Likhain">
            <button class="btn-main" onclick="saveIdentity()">Continue to Search</button>
        </div>
    </div>

    <!-- Main Website Container -->
    <div class="app-container" id="mainApp">
        <div class="brand-header">
            <h1 class="brand-name">TALAL</h1>
            <div class="brand-sub">DON DON INFORMATION ACADEMY</div>
        </div>

        <div class="user-welcome" id="userWelcomeText"></div>
        
        <div class="search-box">
            <input type="text" id="countryInput" placeholder="Mulk ka naam (e.g. Pakistan, Japan, Turkey)...">
            <button class="btn-main" onclick="searchCountry()">Search</button>
        </div>
        
        <p class="error-msg" id="errorText">Mulk nahi mila! Sahi naam English mein likhein.</p>

        <!-- Data Card -->
        <div class="country-card" id="countryCard">
            <div class="flag-container">
                <img src="" alt="Flag" class="flag-img" id="flagImg">
            </div>
            <h2 class="country-title" id="countryName"></h2>
            <div class="info-row"><strong>Official Name:</strong> <span id="officialName"></span></div>
            <div class="info-row"><strong>Capital:</strong> <span id="capital"></span></div>
            <div class="info-row"><strong>Region:</strong> <span id="region"></span></div>
            <div class="info-row"><strong>Population:</strong> <span id="population"></span></div>
            <div class="info-row"><strong>Currencies:</strong> <span id="currency"></span></div>
            <div class="info-row"><strong>Languages:</strong> <span id="languages"></span></div>
            <div class="info-row"><strong>Timezones:</strong> <span id="timezones"></span></div>
        </div>
    </div>

    <script>
        // Automatic login check
        window.onload = function() {
            const savedName = localStorage.getItem('dondon_user_name');
            const savedAge = localStorage.getItem('dondon_user_age');
            if (savedName && savedAge) {
                document.getElementById('identityModal').style.display = 'none';
                document.getElementById('mainApp').style.display = 'block';
                document.getElementById('userWelcomeText').innerText = "Welcome, " + savedName + " (Age: " + savedAge + ")";
            }
        };

        function saveIdentity() {
            const name = document.getElementById('userName').value.trim();
            const age = document.getElementById('userAge').value.trim();

            if (name === "" || age === "") {
                alert("Please Name aur Age dono fill karein!");
                return;
            }

            localStorage.setItem('dondon_user_name', name);
            localStorage.setItem('dondon_user_age', age);
            
            document.getElementById('identityModal').style.display = 'none';
            document.getElementById('mainApp').style.display = 'block';
            document.getElementById('userWelcomeText').innerText = "Welcome, " + name + " (Age: " + age + ")";
        }

        async function searchCountry() {
            const countryName = document.getElementById('countryInput').value.trim();
            const card = document.getElementById('countryCard');
            const errorText = document.getElementById('errorText');

            if (!countryName) return;

            try {
                const response = await fetch(`https://restcountries.com/v3.1/name/${encodeURIComponent(countryName)}`);
                if (!response.ok) throw new Error("Country not found");

                const data = await response.json();
                const country = data[0];

                document.getElementById('flagImg').src = country.flags.png || country.flags.svg;
                document.getElementById('countryName').innerText = country.name.common;
                document.getElementById('officialName').innerText = country.name.official;
                document.getElementById('capital').innerText = country.capital ? country.capital.join(', ') : 'N/A';
                document.getElementById('region').innerText = `${country.region} (${country.subregion || ''})`;
                document.getElementById('population').innerText = country.population.toLocaleString();

                const currencies = country.currencies ? Object.values(country.currencies).map(c => `${c.name} (${c.symbol || ''})`).join(', ') : 'N/A';
                document.getElementById('currency').innerText = currencies;

                const languages = country.languages ? Object.values(country.languages).join(', ') : 'N/A';
                document.getElementById('languages').innerText = languages;

                const timezones = country.timezones ? country.timezones.join(', ') : 'N/A';
                document.getElementById('timezones').innerText = timezones;

                card.style.display = 'block';
                errorText.style.display = 'none';

            } catch (error) {
                card.style.display = 'none';
                errorText.style.display = 'block';
            }
        }
    </script>
</body>
</html>
